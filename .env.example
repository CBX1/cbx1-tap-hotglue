# Copy to .env and fill in. See AGENTS.md → "Environment variables".

# CBX1 Java backend base URL. TRAILING SLASH REQUIRED (code concatenates "api/…").
# QA:   http://java-backend.api.qa.cbx1.internal/
# Prod: ask #eng-crm-self-serve for the current value.
BASE_URL=

# Optional. UUID of HotGlue's CBX1 SERVICE_ACCOUNT for this environment.
# When set, the tap drops records last-modified by this principal (avoids
# re-ingesting our own writes). Env-specific, not tenant-specific.
HOTGLUE_PRINCIPAL_ID=
